#!/bin/sh
set -e

main() {
  if ! command -v node > /dev/null 2>&1; then
    err "node is not installed. Install Node.js 18+ from https://nodejs.org"
  fi

  node_major=$(node -v | sed 's/v//' | cut -d. -f1)
  if [ "$node_major" -lt 18 ]; then
    err "Node.js 18+ required (found $(node -v)). Install from https://nodejs.org"
  fi

  if ! command -v npm > /dev/null 2>&1; then
    err "npm is not installed"
  fi

  echo "installing @boole/cli..."
  npm install -g @boole/cli

  echo ""
  echo "installed $(boole --version)"
  echo "run 'boole --help' to get started"
}

err() {
  echo "error: $1" >&2
  exit 1
}

main "$@"
